# =================================================================
# NyayaGuide AI - Environment Configuration Example
# Copy this file to .env and configure values as needed.
# NEVER commit real production secrets or API keys to version control.
# =================================================================

# Server Port
PORT=5000

# Client Application URL (For production CORS protection)
# In development, localhost and 127.0.0.1 are automatically permitted.
CLIENT_URL=http://localhost:5173

# Admin Secret Key (Protects POST /api/sources from unauthorized modification)
ADMIN_SECRET=nyaya_admin_secret

# Optional Google Gemini API Key for dynamic LLM reasoning
# If left empty, NyayaGuide automatically uses the deterministic Curated Statutory Knowledge Base
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Database URL (For future PostgreSQL migration; SQLite / file-backed JSON store is used by default)
DATABASE_URL=file:./data/nyayaguide_db.json

# Environment Mode (development | production)
NODE_ENV=development
